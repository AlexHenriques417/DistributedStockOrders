// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PIX
  BOLETO
  BANK_TRANSFER
  WALLET
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

// ==================== USER MODELS ====================

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          String         @default("customer")
  status        String         @default("active")
  emailVerified Boolean        @default(false)
  phone         String?
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastLoginAt   DateTime?

  addresses     UserAddress[]
  sessions      UserSession[]
  preferences   UserPreference?
  auditLogs     AuditLog[]

  @@index([email], name: "idx_user_email")
  @@index([role], name: "idx_user_role")
  @@index([status], name: "idx_user_status")
  @@map("users")
}

model UserAddress {
  id           String   @id @default(uuid())
  userId       String
  addressType  String   @default("shipping")
  street       String
  number       String?
  complement   String?
  city         String
  state        String
  country      String
  postalCode   String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_user_address_user_id")
  @@map("user_addresses")
}

model UserSession {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String
  refreshTokenHash  String?
  deviceInfo        Json?
  ipAddress         String?
  userAgent         String?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  lastActivityAt    DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_user_session_user_id")
  @@index([tokenHash], name: "idx_user_session_token_hash")
  @@map("user_sessions")
}

model UserPreference {
  id            String   @id @default(uuid())
  userId        String   @unique
  language      String    @default("pt-BR")
  currency      String    @default("BRL")
  theme         String    @default("light")
  notifications Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model AuditLog {
  id          String    @id @default(uuid())
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], name: "idx_audit_log_user_id")
  @@index([createdAt], name: "idx_audit_log_created_at")
  @@map("audit_log")
}

// ==================== PAYMENT MODELS ====================

model Payment {
  id              String           @id @default(uuid())
  orderId         String
  userId          String
  amount          Decimal          @db.Decimal(10, 2)
  currency        String           @default("BRL")
  status          PaymentStatus    @default(PENDING)
  paymentMethod   PaymentMethod
  description     String?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  processedAt     DateTime?
  completedAt     DateTime?

  transactions    PaymentTransaction[]
  refunds         Refund[]
  paymentMethodDetails UserPaymentMethod?

  @@index([orderId], name: "idx_payment_order_id")
  @@index([userId], name: "idx_payment_user_id")
  @@index([status], name: "idx_payment_status")
  @@index([createdAt], name: "idx_payment_created_at")
  @@map("payments")
}

model PaymentTransaction {
  id              String      @id @default(uuid())
  paymentId       String
  transactionType String      // PAYMENT, REFUND, CHARGEBACK
  amount          Decimal     @db.Decimal(10, 2)
  status          String      @default("PROCESSING") // PROCESSING, COMPLETED, FAILED
  gatewayResponse Json?
  gatewayTxId     String?
  processedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  payment         Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId], name: "idx_transaction_payment_id")
  @@index([gatewayTxId], name: "idx_transaction_gateway_tx_id")
  @@index([transactionType], name: "idx_transaction_type")
  @@map("payment_transactions")
}

model Refund {
  id              String        @id @default(uuid())
  paymentId       String
  amount          Decimal       @db.Decimal(10, 2)
  status          RefundStatus  @default(PENDING)
  reason          String?
  gatewayResponse Json?
  gatewayRefundId String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payment         Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId], name: "idx_refund_payment_id")
  @@index([status], name: "idx_refund_status")
  @@map("refunds")
}

model UserPaymentMethod {
  id              String       @id @default(uuid())
  paymentId       String       @unique
  methodType      PaymentMethod
  cardLastFour    String?
  cardBrand       String?
  cardExpiryMonth Int?
  cardExpiryYear  Int?
  cardholderName  String?
  pixKey          String?
  boletoBarcode   String?
  boletoDueDate   DateTime?
  isDefault       Boolean      @default(false)
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  payment         Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("user_payment_methods")
}