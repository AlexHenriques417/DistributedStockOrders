{
  "name": "microservices-project",
  "version": "1.0.0",
  "description": "Microservices E-commerce Platform with Event-Driven Architecture",
  "private": true,
  "workspaces": [
    "backend/api-gateway",
    "backend/user-service",
    "backend/catalog-service",
    "backend/inventory-service",
    "backend/order-service",
    "backend/payment-service",
    "frontend/web-app",
    "infra/scripts"
  ],
  "scripts": {
    "install:all": "npm install && npm run install:services",
    "install:services": "npm run install:gateway && npm run install:user && npm run install:catalog && npm run install:inventory && npm run install:order && npm run install:payment",
    "install:gateway": "cd backend/api-gateway && npm install",
    "install:user": "cd backend/user-service && npm install",
    "install:catalog": "cd backend/catalog-service && npm install",
    "install:inventory": "cd backend/inventory-service && npm install",
    "install:order": "cd backend/order-service && npm install",
    "install:payment": "cd backend/payment-service && npm install",
    "build:all": "npm run build:gateway && npm run build:user && npm run build:catalog && npm run build:inventory && npm run build:order && npm run build:payment",
    "build:gateway": "cd backend/api-gateway && npm run build",
    "build:user": "cd backend/user-service && npm run build",
    "build:catalog": "cd backend/catalog-service && npm run build",
    "build:inventory": "cd backend/inventory-service && npm run build",
    "build:order": "cd backend/order-service && npm run build",
    "build:payment": "cd backend/payment-service && npm run build",
    "test:all": "npm run test:gateway && npm run test:user && npm run test:catalog && npm run test:inventory && npm run test:order && npm run test:payment",
    "test:gateway": "cd backend/api-gateway && npm test",
    "test:user": "cd backend/user-service && npm test",
    "test:catalog": "cd backend/catalog-service && npm test",
    "test:inventory": "cd backend/inventory-service && npm test",
    "test:order": "cd backend/order-service && npm test",
    "test:payment": "cd backend/payment-service && npm test",
    "docker:up": "cd infrastructure && docker-compose up -d",
    "docker:down": "cd infrastructure && docker-compose down",
    "docker:logs": "cd infrastructure && docker-compose logs -f",
    "dev": "concurrently \"npm run dev:gateway\" \"npm run dev:user\" \"npm run dev:catalog\" \"npm run dev:inventory\" \"npm run dev:order\" \"npm run dev:payment\"",
    "dev:gateway": "cd backend/api-gateway && npm run dev",
    "dev:user": "cd backend/user-service && npm run dev",
    "dev:catalog": "cd backend/catalog-service && npm run dev",
    "dev:inventory": "cd backend/inventory-service && npm run dev",
    "dev:order": "cd backend/order-service && npm run dev",
    "dev:payment": "cd backend/payment-service && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "microservices",
    "event-driven",
    "cqrs",
    "nestjs",
    "typescript",
    "docker",
    "kubernetes",
    "rabbitmq",
    "redis",
    "postgresql"
  ],
  "author": "",
  "license": "MIT"
}
