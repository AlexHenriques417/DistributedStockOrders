      "destination": "dlq",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    }
  ],
  "policies": [
    {
      "name": "ha-all",
      "vhost": "/",
      "pattern": ".*",
      "apply-to": "all",
      "definition": {
